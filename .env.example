# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL — already running in Docker) ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convflow

# ── Redis (running on host) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OpenWA Gateway (self-hosted — internal Docker network) ────────────────────
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=your_openwa_api_key_here
OPENWA_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ── Platform Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production

# ── Public URL (used for ERPNext frappe_whatsapp proxy) ──────────────────────
CONVFLOW_PUBLIC_URL=https://bots.ivarse.com

# ── ConvFlow API Base (used by dashboard) ────────────────────────────────────
CONVFLOW_API_URL=http://localhost:3000

# ── Company: IVarse Technologies ─────────────────────────────────────────────
IVARSE_OPENWA_SESSION_ID=ivarse-bot
IVARSE_OWNER_PHONE=2348XXXXXXXXXX

# ── Company: Avril Beetails ───────────────────────────────────────────────────
AVRIL_OPENWA_SESSION_ID=avril-bot
AVRIL_OWNER_PHONE=2348XXXXXXXXXX

# ── Company: That Ofada Girl ──────────────────────────────────────────────────
OFADA_OPENWA_SESSION_ID=ofada-bot
OFADA_OWNER_PHONE=2348XXXXXXXXXX
